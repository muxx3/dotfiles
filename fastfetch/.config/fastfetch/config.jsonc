{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/Downloads/dokidoki.jpg",
    	"type": "auto",
    	"height": 13,
    	"padding": {
            "top": 2,
    		"left": 2,
            "right": 1
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
        {
            "type": "os",
            "key": "os       ",
            "keyColor": "white" 
        },
        {
            "type": "kernel",
            "key": "kernel   ",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "key": "editor    Neovim(btw)",
            "keyColor": "blue" 
        },
        {
            "type": "shell",
            "key": "shell    ",
            "keyColor": "blue" 
        },
        {
            "type": "terminal",
            "key": "terminal ",
            "keyColor": "blue" 
        },
        {
            "type": "wm",
            "key": "wm       ",
            "keyColor": "blue" 
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime   ",
            "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "memory   ",
            "keyColor": "white",
            "percent": {
                "type": 1,     // Show both percentage number and bar
                "green": 30,   // Values below 30% in green
                "yellow": 70   // 30-70% in yellow, >70% in red
            }
        },
        {
            "type": "cpu",
            "format": "      {name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
        },
        {
            "type": "custom",
            "key": "language  Rust",
            "keyColor": "white"
        },
        "break",
        "break",
        "break"
        //{
            //"type": "colors",
        //}
    ] 
}

